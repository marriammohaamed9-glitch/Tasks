#include <iostream>
using namespace std;

int main() {
    int n;
    int comparisons = 0;

    cout << "Enter number of elements: ";
    cin >> n;

    if (n <= 0 || n > 1000) {
        cout << "Invalid number of elements!";
        return 0;
    }

    int arr[1000];

    cout << "Enter the elements:\n";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    int maximum = arr[0];
    int minimum = arr[0];

    for (int i = 1; i < n; i++) {
        comparisons++;

        if (arr[i] > maximum) {
            maximum = arr[i];
        }

        comparisons++;

        if (arr[i] < minimum) {
            minimum = arr[i];
        }
    }

    cout << "\nMaximum = " << maximum << endl;
    cout << "Minimum = " << minimum << endl;
    cout << "Comparisons = " << comparisons << endl;

    return 0;
}
