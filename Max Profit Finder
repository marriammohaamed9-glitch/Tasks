#include <iostream>
#include <vector>
#include <chrono>
#include <fstream>
#include <iomanip>
using namespace std;
using namespace chrono;

struct Result {
    int profit;
    int buyDay;
    int sellDay;
};


Result linearScan(const vector<int>& prices) {
    int minPrice = prices[0];
    int minDay = 0;
    Result best{ 0, 0, 0 };

    for (int i = 1; i < (int)prices.size(); i++) {
        int currentProfit = prices[i] - minPrice;

        if (currentProfit > best.profit) {
            best = { currentProfit, minDay, i };
        }

        if (prices[i] < minPrice) {
            minPrice = prices[i];
            minDay = i;
        }
    }

    return best;
}


Result divideAndConquer(
    const vector<int>& prices,
    int left,
    int right
) {
    if (left >= right) {
        return { 0, left, left };
    }

    int mid = left + (right - left) / 2;

    Result leftResult =
        divideAndConquer(prices, left, mid);

    Result rightResult =
        divideAndConquer(prices, mid + 1, right);

   
    int minDay = left;

    for (int i = left + 1; i <= mid; i++) {
        if (prices[i] < prices[minDay]) {
            minDay = i;
        }
    }

  
    int maxDay = mid + 1;

    for (int i = mid + 2; i <= right; i++) {
        if (prices[i] > prices[maxDay]) {
            maxDay = i;
        }
    }

   
    Result crossResult{
        prices[maxDay] - prices[minDay],
        minDay,
        maxDay
    };

    Result best = leftResult;

    if (rightResult.profit > best.profit) {
        best = rightResult;
    }

    if (crossResult.profit > best.profit) {
        best = crossResult;
    }

    return best;
}


void displayResult(
    const string& method,
    Result result,
    const vector<int>& prices,
    double timeMs
) {
    cout << method << "\n";
    cout << "Maximum Profit: "
         << result.profit << "\n";

    if (result.profit > 0) {
        cout << "Buy Day: "
             << result.buyDay + 1
             << ", Price: "
             << prices[result.buyDay] << "\n";

        cout << "Sell Day: "
             << result.sellDay + 1
             << ", Price: "
             << prices[result.sellDay] << "\n";
    }
    else {
        cout << "No profitable transaction available.\n";
    }

    cout << "Execution Time: "
         << fixed << setprecision(6)
         << timeMs << " ms\n\n";
}

