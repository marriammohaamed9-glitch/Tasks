    cout << "================================\n";
    cout << "       MAX PROFIT FINDER\n";
    cout << "================================\n\n";

    int n;

    cout << "Enter number of days (at least 2): ";
    cin >> n;

    if (!cin || n < 2) {
        cout << "Please enter at least 2 days.\n";
        return 1;
    }

    vector<int> prices(n);

    cout << "\nEnter stock prices:\n";

    for (int i = 0; i < n; i++) {
        cout << "Day " << i + 1 << ": ";
        cin >> prices[i];

        if (!cin || prices[i] < 0) {
            cout << "Invalid price.\n";
            return 1;
        }
    }

    cout << "\nStock Prices: ";

    for (int price : prices) {
        cout << price << " ";
    }

    cout << "\n\n";

    auto start1 = high_resolution_clock::now();

    Result linearResult = linearScan(prices);

    auto end1 = high_resolution_clock::now();

    double linearTime =
        duration<double, milli>(end1 - start1).count();

  
    auto start2 = high_resolution_clock::now();

    Result dcResult =
        divideAndConquer(prices, 0, n - 1);

    auto end2 = high_resolution_clock::now();

    double dcTime =
        duration<double, milli>(end2 - start2).count();


    displayResult(
        "1. Linear Scan - O(n)",
        linearResult,
        prices,
        linearTime
    );
displayResult(
        "2. Divide and Conquer - O(n log n)",
        dcResult,
        prices,
        dcTime
    );

   
    if (linearResult.profit == dcResult.profit) {
        cout << "Verification: Both methods agree.\n";
    }
    else {
        cout << "Verification failed.\n";
    }

  
    ofstream file("max_profit_results.csv");

    if (file.is_open()) {
        file << "Method,Input Size,Maximum Profit,Execution Time (ms)\n";

        file << "Linear Scan,"
             << n << ","
             << linearResult.profit << ","
             << setprecision(10)
             << linearTime << "\n";

        file << "Divide and Conquer,"
             << n << ","
             << dcResult.profit << ","
             << setprecision(10)
             << dcTime << "\n";

        file.close();

        cout << "\nResults saved to max_profit_results.csv\n";
    }
    else {
        cout << "\nCould not create the CSV file.\n";
    }

    return 0;
}
